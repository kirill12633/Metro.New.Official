```html
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>World Holidays</title>
    <meta
        name="description"
        content="Календарь международных праздников и памятных дат"
    >

    <link rel="stylesheet" href="style.css">
</head>

<body>

<header class="header">
    <div class="container header-inner">

        <a href="#" class="logo">
            <span class="logo-icon">🌍</span>
            <span>World Holidays</span>
        </a>

        <div class="header-actions">
            <button id="todayBtn" class="today-btn">
                Сегодня
            </button>

            <div class="search">
                <span>🔎</span>
                <input
                    id="searchInput"
                    type="search"
                    placeholder="Поиск праздника..."
                    autocomplete="off"
                >
            </div>
        </div>

    </div>
</header>


<main class="container">

    <section class="hero">
        <div>
            <p class="eyebrow">HOLIDAY CALENDAR</p>
            <h1>Праздники мира</h1>
            <p class="hero-text">
                Международные праздники, памятные даты и особые дни
                в одном календаре.
            </p>
        </div>

        <div class="stats">
            <div class="stat">
                <strong id="holidayCount">0</strong>
                <span>праздников</span>
            </div>

            <div class="stat">
                <strong id="yearCount">0</strong>
                <span>на этот год</span>
            </div>
        </div>
    </section>


    <section class="toolbar">

        <div class="month-navigation">
            <button id="prevMonth" class="nav-btn" aria-label="Предыдущий месяц">
                ←
            </button>

            <div>
                <h2 id="monthTitle">Сентябрь 2026</h2>
                <p id="monthSubtitle">2026</p>
            </div>

            <button id="nextMonth" class="nav-btn" aria-label="Следующий месяц">
                →
            </button>
        </div>

        <div class="filters">
            <label>
                Категория
                <select id="categoryFilter">
                    <option value="all">Все</option>
                </select>
            </label>
        </div>

    </section>


    <section class="calendar-card">

        <div class="weekdays">
            <div>Пн</div>
            <div>Вт</div>
            <div>Ср</div>
            <div>Чт</div>
            <div>Пт</div>
            <div>Сб</div>
            <div>Вс</div>
        </div>

        <div id="calendar" class="calendar">
            <!-- JavaScript вставит дни сюда -->
        </div>

    </section>


    <section class="today-section">

        <div class="section-title">
            <div>
                <p class="eyebrow">TODAY</p>
                <h2 id="todayTitle">Сегодня</h2>
            </div>
        </div>

        <div id="todayHolidays" class="holiday-list">
            <!-- JavaScript -->
        </div>

    </section>


    <section id="searchSection" class="search-section hidden">

        <div class="section-title">
            <div>
                <p class="eyebrow">SEARCH</p>
                <h2>Результаты поиска</h2>
            </div>
        </div>

        <div id="searchResults" class="search-results"></div>

    </section>

</main>


<div id="modal" class="modal hidden">

    <div class="modal-backdrop" id="modalBackdrop"></div>

    <div class="modal-window">

        <button id="closeModal" class="modal-close">
            ×
        </button>

        <div id="modalContent"></div>

    </div>

</div>


<footer class="footer">
    <div class="container">
        <p>
            🌍 World Holidays · Данные загружаются из holidays.json
        </p>
    </div>
</footer>


<script src="script.js"></script>

</body>
</html>
```
